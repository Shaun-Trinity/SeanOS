# Copy to .env.local for local testing (`npm run dev`). On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit real values.

# The password you type on the SeanOS login screen. Use a long, unique one.
ADMIN_PASSWORD=change-me

# Signs the login cookie. Any random string of 32+ characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Vercel adds BLOB_READ_WRITE_TOKEN automatically when you connect a Blob store. Leave it out locally.
